# #Misfits Add - Doomarm.

action-name-doomarm-lunge = Kinetic Discharge
action-desc-doomarm-lunge = Charge the Doomarm for a second, then lunge where you clicked. The first person in front of you takes a heavy blow and gets sent flying. Moving while charging cancels it.
action-name-doomarm-slam = Groundbreaker
action-desc-doomarm-slam = Leap toward where you click (up to 4 tiles) and smash the ground where you land. Everyone in the 3x3 around you is hurt and slowed.
action-name-doomarm-descent = Orbital Descent
action-desc-doomarm-descent = Launch yourself up to the level above, steer for a moment, then crash down on a 5x5 area. The closer to the centre, the harder it hits. Needs open sky above you, or you'll hit the ceiling.

doomarm-fist-locked = It's part of the Doomarm. Only surgery takes it off.
doomarm-not-working = Your Doomarm isn't working.
doomarm-busy = You're already using the Doomarm.
doomarm-overheat = The Doomarm's coils sear your flesh!
doomarm-examine-heat = The heat gauge reads [color=orange]{ $heat }%[/color].

doomarm-surgery-not-self = You can't attach a Doomarm to yourself.
doomarm-surgery-not-autodoc = Fitting a Doomarm needs a real surgeon's hands.
doomarm-surgery-wrong-species = The Doomarm is far too big for this body.
doomarm-surgery-already-has = They already have a Doomarm.

doomarm-lunge-charging = { CAPITALIZE(THE($user)) }'s Doomarm whines as it charges!
doomarm-descent-no-sky = There's nowhere higher to go from here.
doomarm-descent-ceiling-self = You slam into the ceiling!
doomarm-descent-ceiling-others = { CAPITALIZE(THE($user)) } leaps and slams into the ceiling!
doomarm-descent-warning = Something is coming down from above!
doomarm-descent-landed = { CAPITALIZE(THE($user)) } crashes down from the sky!

# Shouts, like a warcry. One is picked at random each use.
doomarm-shout-lunge-1 = OUT OF MY WAY!
doomarm-shout-lunge-2 = YOU CAN'T RUN FROM ME!
doomarm-shout-lunge-3 = SMASH!
doomarm-shout-slam-1 = THE GROUND BREAKS FOR ME!
doomarm-shout-slam-2 = FALL DOWN, LITTLE HUMANS!
doomarm-shout-slam-3 = CRUSH!
doomarm-shout-descent-1 = LOOK UP, PUNY HUMANS!
doomarm-shout-descent-2 = DEATH FROM ABOVE!
doomarm-shout-descent-3 = NOWHERE TO HIDE!
