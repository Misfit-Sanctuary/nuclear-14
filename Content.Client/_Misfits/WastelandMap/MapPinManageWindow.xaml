<DefaultWindow xmlns="https://spacestation14.io" Title="{Loc mappin-manage-title}" MinWidth="440" MinHeight="240" SetSize="440 360">
    <BoxContainer Orientation="Vertical" Margin="8">
        <BoxContainer Name="ManagePanel" Orientation="Vertical" VerticalExpand="True">
            <Label Text="{Loc mappin-manage-prompt}" Margin="0 0 0 6" />
            <ScrollContainer VerticalExpand="True">
                <BoxContainer Name="PinList" Orientation="Vertical" />
            </ScrollContainer>
            <Button Name="CreateButton" Text="{Loc mappin-manage-create}" HorizontalAlignment="Right" MinWidth="130" Margin="0 8 0 0" />
        </BoxContainer>
        <BoxContainer Name="CreatePanel" Orientation="Vertical" Visible="False">
            <Label Text="{Loc mappin-window-prompt}" Margin="0 0 0 6" />
            <LineEdit Name="NameInput" PlaceHolder="{Loc mappin-window-placeholder}" HorizontalExpand="True" Margin="0 0 0 8" />
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="CancelButton" Text="{Loc mappin-window-cancel}" Margin="0 0 6 0" MinWidth="80" />
                <Button Name="SubmitButton" Text="{Loc mappin-window-submit}" MinWidth="80" StyleClasses="Caution" />
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
