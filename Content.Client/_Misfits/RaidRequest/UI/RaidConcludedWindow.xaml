<!-- #Misfits Refactor - Mandatory raid-over acknowledgement, laid out like the faction recruit offer dialog. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'raid-concluded-window-title'}"
                      Resizable="False"
                      SetSize="480 230"
                      MinSize="440 210">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <RichTextLabel Name="HeaderLabel" HorizontalExpand="True" />
        <RichTextLabel Name="PartiesLabel" HorizontalExpand="True" />
        <PanelContainer StyleClasses="BackgroundDark" VerticalExpand="True">
            <RichTextLabel Text="{Loc 'raid-concluded-warning'}" Margin="6 4" HorizontalExpand="True" />
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Control HorizontalExpand="True" />
            <Button Name="AcknowledgeButton" Text="{Loc 'raid-concluded-acknowledge'}" MinWidth="160" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
