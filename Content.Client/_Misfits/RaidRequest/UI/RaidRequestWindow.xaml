<!-- #Misfits Refactor - /raid requester window, laid out like the faction roster / recruit window:
     a summary row, then tabs for "Raids" (approved and live raids, join a side during prep),
     "Declare Raid" (target, location, reason, preview, submit) and "My requests" (status cards). -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'raid-request-window-title'}"
                      MinSize="540 460"
                      SetSize="600 540">
    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="6">

        <!-- Who you're raiding as, and whether you may -->
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Name="MyFactionLabel" StyleClasses="LabelHeading" />
                <Label Name="EligibilityLabel" StyleClasses="LabelSubText" />
            </BoxContainer>
            <Button Name="RefreshButton" Text="{Loc 'raid-request-refresh'}" MinWidth="90" VerticalAlignment="Center" />
        </BoxContainer>

        <TabContainer Name="Tabs" VerticalExpand="True">

            <!-- Raids: approved and live raids, with Join buttons during prep (like /war) -->
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="4">
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="OpenRaidsContainer" Orientation="Vertical" SeparationOverride="4" />
                </ScrollContainer>
                <!-- #Cythisiax Fixed - long note was a non-wrapping LabelSubText that ran off the window -->
                <PanelContainer StyleClasses="BackgroundDark">
                    <RichTextLabel Text="{Loc 'raid-request-join-note'}" Margin="6 4" HorizontalExpand="True" />
                </PanelContainer>
            </BoxContainer>

            <!-- Declare Raid -->
            <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="4">
                <Label Text="{Loc 'raid-request-step-target'}" StyleClasses="LabelKeyText" />
                <OptionButton Name="TargetSelector" HorizontalExpand="True" />

                <Label Text="{Loc 'raid-request-step-location'}" StyleClasses="LabelKeyText" />
                <LineEdit Name="LocationEdit" PlaceHolder="{Loc 'raid-request-location-placeholder'}"
                          HorizontalExpand="True" />

                <Label Text="{Loc 'raid-request-step-reason'}" StyleClasses="LabelKeyText" />
                <LineEdit Name="ReasonEdit" PlaceHolder="{Loc 'raid-request-reason-placeholder'}"
                          HorizontalExpand="True" />
                <Label Name="ReasonCounterLabel" StyleClasses="LabelSubText" />

                <PanelContainer StyleClasses="BackgroundDark" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="6 4" SeparationOverride="4">
                        <Label Text="{Loc 'raid-request-step-review'}" StyleClasses="LabelKeyText" />
                        <RichTextLabel Name="PreviewLabel" HorizontalExpand="True" />
                        <RichTextLabel Name="ProcessLabel" HorizontalExpand="True" />
                    </BoxContainer>
                </PanelContainer>

                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Control HorizontalExpand="True" />
                    <Button Name="SubmitButton" Text="{Loc 'raid-request-submit-button'}"
                            MinWidth="160" StyleClasses="Caution" />
                </BoxContainer>
            </BoxContainer>

            <!-- My requests -->
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="4">
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="MyRequestsContainer" Orientation="Vertical" SeparationOverride="4" />
                </ScrollContainer>
            </BoxContainer>
        </TabContainer>

        <Label Name="ResultLabel" StyleClasses="LabelSubText" Visible="False" />
    </BoxContainer>
</controls:FancyWindow>
