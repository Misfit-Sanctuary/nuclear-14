<!-- #Misfits Refactor - Peer-approval popup shown to the highest-ranking online member of a
     target faction or group when someone submits a /raid request against them. Laid out like
     the faction recruit offer dialog: heading, details, note, then Refuse / Allow at the bottom right. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'raid-request-peer-window-title'}"
                      MinSize="480 380"
                      SetSize="520 420">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="HeaderTitleLabel" StyleClasses="LabelHeading" />
        <RichTextLabel Name="HeaderLabel" HorizontalExpand="True" />

        <PanelContainer StyleClasses="BackgroundDark" VerticalExpand="True">
            <ScrollContainer HScrollEnabled="False">
                <BoxContainer Orientation="Vertical" Margin="6 4" SeparationOverride="4">
                    <Label Text="{Loc 'raid-request-peer-from-label'}" StyleClasses="LabelKeyText" />
                    <RichTextLabel Name="FromLabel" HorizontalExpand="True" />
                    <Label Text="{Loc 'raid-request-peer-location-label'}" StyleClasses="LabelKeyText" />
                    <RichTextLabel Name="LocationLabel" HorizontalExpand="True" />
                    <Label Text="{Loc 'raid-request-peer-reason-label'}" StyleClasses="LabelKeyText" />
                    <RichTextLabel Name="ReasonLabel" HorizontalExpand="True" />
                </BoxContainer>
            </ScrollContainer>
        </PanelContainer>

        <LineEdit Name="CommentEdit" PlaceHolder="{Loc 'raid-request-peer-comment-placeholder'}"
                  HorizontalExpand="True" />
        <!-- #Cythisiax Fixed - long note was a non-wrapping LabelSubText that ran off the window -->
        <PanelContainer StyleClasses="BackgroundDark">
            <RichTextLabel Text="{Loc 'raid-request-peer-note'}" Margin="6 4" HorizontalExpand="True" />
        </PanelContainer>
        <RichTextLabel Name="StatusLabel" HorizontalExpand="True" />

        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Control HorizontalExpand="True" />
            <Button Name="DenyButton" Text="{Loc 'raid-request-peer-deny-button'}" MinWidth="120" />
            <Button Name="ApproveButton" Text="{Loc 'raid-request-peer-approve-button'}" MinWidth="120"
                    StyleClasses="Caution" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
