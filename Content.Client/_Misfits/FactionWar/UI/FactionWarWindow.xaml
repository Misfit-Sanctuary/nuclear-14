<!-- #Misfits Refactor - /war panel, laid out like the faction roster / recruit window:
     a summary row, one notice line, and tabs for "Wars" (see, join, ceasefire), "Declare War" and "My requests" (wars you are in).
     /warjoin opens this same window on the Wars tab. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'faction-war-window-title'}"
                      MinSize="560 460"
                      SetSize="640 560">
    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="6">

        <!-- Who you are and where you stand -->
        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Name="SummaryLabel" StyleClasses="LabelHeading" />
                <Label Name="SummarySubLabel" StyleClasses="LabelSubText" />
            </BoxContainer>
            <Button Name="RefreshButton" Text="{Loc 'faction-war-refresh'}" MinWidth="90" VerticalAlignment="Center" />
        </BoxContainer>

        <!-- War never authorises a raid on its own -->
        <PanelContainer StyleClasses="BackgroundDark">
            <Label Name="RaidNoticeLabel" Text="{Loc 'faction-war-raid-notice'}" Margin="6 4" />
        </PanelContainer>

        <!-- Incoming ceasefire: shown above the tabs so it can't be missed -->
        <PanelContainer Name="CeasefireBanner" StyleClasses="BackgroundDark" Visible="False">
            <BoxContainer Orientation="Horizontal" SeparationOverride="6" Margin="6 4">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <Label Name="CeasefireBannerLabel" />
                    <Label Text="{Loc 'faction-war-ceasefire-incoming-hint'}" StyleClasses="LabelSubText" />
                </BoxContainer>
                <Button Name="RejectCeasefireProposalButton" Text="{Loc 'faction-war-ceasefire-reject'}"
                        MinWidth="100" StyleClasses="Caution" VerticalAlignment="Center" />
                <Button Name="AcceptCeasefireProposalButton" Text="{Loc 'faction-war-ceasefire-accept'}"
                        MinWidth="120" VerticalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>

        <TabContainer Name="Tabs" VerticalExpand="True">

            <!-- Wars tab: every war this round, with join / ceasefire actions inline -->
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="4">
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="WarList" Orientation="Vertical" SeparationOverride="4" />
                </ScrollContainer>
                <!-- #Cythisiax Fixed - long note was a non-wrapping LabelSubText that ran off the window -->
                <PanelContainer StyleClasses="BackgroundDark">
                    <RichTextLabel Text="{Loc 'faction-war-join-kos-note'}" Margin="6 4" HorizontalExpand="True" />
                </PanelContainer>
            </BoxContainer>

            <!-- Declare tab: pick a target, give a reason, confirm -->
            <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="4">
                <Label Name="DeclareLockedLabel" Visible="False" />

                <Label Text="{Loc 'faction-war-step-target'}" StyleClasses="LabelKeyText" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="0">
                    <Button Name="FactionKindButton" Text="{Loc 'faction-war-kind-faction'}"
                            ToggleMode="True" MinWidth="110" StyleClasses="OpenRight" />
                    <Button Name="GroupKindButton" Text="{Loc 'faction-war-kind-group'}"
                            ToggleMode="True" MinWidth="110" StyleClasses="OpenLeft" />
                    <Control MinWidth="8" />
                    <OptionButton Name="TargetSelector" HorizontalExpand="True" />
                </BoxContainer>

                <Label Text="{Loc 'faction-war-step-reason'}" StyleClasses="LabelKeyText" />
                <LineEdit Name="CasusBelliEdit" PlaceHolder="{Loc 'faction-war-casus-belli-placeholder'}"
                          HorizontalExpand="True" />
                <Label Name="ReasonCounterLabel" StyleClasses="LabelSubText" />

                <PanelContainer StyleClasses="BackgroundDark" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" Margin="6 4" SeparationOverride="4">
                        <Label Text="{Loc 'faction-war-step-review'}" StyleClasses="LabelKeyText" />
                        <RichTextLabel Name="DeclarePreviewLabel" HorizontalExpand="True" />
                        <RichTextLabel Name="RulesLabel" HorizontalExpand="True" />
                    </BoxContainer>
                </PanelContainer>

                <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                    <Control HorizontalExpand="True" />
                    <Button Name="DeclareWarButton" Text="{Loc 'faction-war-declare-button'}"
                            MinWidth="160" StyleClasses="Caution" />
                </BoxContainer>
            </BoxContainer>

            <!-- My requests: wars you declared, were declared against, or joined -->
            <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="4">
                <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                    <BoxContainer Name="MyWarsList" Orientation="Vertical" SeparationOverride="4" />
                </ScrollContainer>
            </BoxContainer>
        </TabContainer>

        <Label Name="StatusLabel" StyleClasses="LabelSubText" Visible="False" />
    </BoxContainer>
</controls:FancyWindow>
