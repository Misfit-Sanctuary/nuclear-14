<!-- #Misfits Refactor - Side review, laid out like the faction roster: one row per fighter,
     a Remove toggle on each, and a single confirm button at the bottom right. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'faction-war-review-title'}"
                      MinSize="460 360"
                      SetSize="520 480">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="HeaderLabel" StyleClasses="LabelHeading" />
        <Label Text="{Loc 'faction-war-review-hint'}" StyleClasses="LabelSubText" />
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="ParticipantsContainer" Orientation="Vertical" SeparationOverride="2" />
        </ScrollContainer>
        <RichTextLabel Name="ResultLabel" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Label Name="RemoveCountLabel" StyleClasses="LabelSubText" HorizontalExpand="True" VerticalAlignment="Center" />
            <Button Name="SubmitButton" Text="{Loc 'faction-war-review-submit'}" MinWidth="160" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
