<!-- #Misfits Refactor - War invitation, laid out like the faction recruit offer dialog. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'faction-war-invite-title'}"
                      MinSize="440 220"
                      SetSize="480 240">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <Label Name="HeaderLabel" StyleClasses="LabelHeading" />
        <RichTextLabel Name="InviteLabel" HorizontalExpand="True" VerticalExpand="True" />
        <Label Text="{Loc 'faction-war-invite-note'}" StyleClasses="LabelSubText" />
        <RichTextLabel Name="ResultLabel" HorizontalExpand="True" />
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Control HorizontalExpand="True" />
            <Button Name="DeclineButton" Text="{Loc 'faction-war-invite-decline'}" MinWidth="120" StyleClasses="Caution" />
            <Button Name="AcceptButton" Text="{Loc 'faction-war-invite-accept'}" MinWidth="120" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
