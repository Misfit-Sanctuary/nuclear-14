<!-- #Misfits Add - Message of the Day window layout. -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="Message of the Day"
                      Resizable="True"
                      SetSize="560 640"
                      MinSize="380 300">
    <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
        <BoxContainer Orientation="Vertical" SeparationOverride="10" Margin="10 8 10 8" HorizontalExpand="True">
            <!-- Opens the editor below. Only visible to admins. -->
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <Button Name="EditToggleButton" MinWidth="150"/>
            </BoxContainer>
            <PanelContainer Name="EditPanel" HorizontalExpand="True" Visible="False">
                <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="10 8 10 8" HorizontalExpand="True">
                    <Label Name="EditHeader" HorizontalExpand="True"/>
                    <Label Name="EditTextLabel" HorizontalExpand="True"/>
                    <TextEdit Name="EditText" MinHeight="90" HorizontalExpand="True"/>
                    <Label Name="EditImagesLabel" HorizontalExpand="True"/>
                    <LineEdit Name="EditImages" HorizontalExpand="True"/>
                    <Label Name="EditQuestionLabel" HorizontalExpand="True"/>
                    <LineEdit Name="EditQuestion" HorizontalExpand="True"/>
                    <Label Name="EditOptionsLabel" HorizontalExpand="True"/>
                    <LineEdit Name="EditOptions" HorizontalExpand="True"/>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True">
                        <Button Name="SaveButton" MinWidth="170"/>
                        <Button Name="ClearPollButton" MinWidth="140"/>
                    </BoxContainer>
                    <Label Name="EditHint" HorizontalExpand="True"/>
                </BoxContainer>
            </PanelContainer>
            <PanelContainer HorizontalExpand="True">
                <RichTextLabel Name="MotdText" HorizontalExpand="True" Margin="10 8 10 8"/>
            </PanelContainer>
            <BoxContainer Name="ImagesContainer" Orientation="Vertical" SeparationOverride="6"
                          HorizontalExpand="True" Visible="False"/>
            <PanelContainer Name="PollPanel" HorizontalExpand="True" Visible="False">
                <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="10 8 10 8" HorizontalExpand="True">
                    <Label Name="PollQuestion" HorizontalExpand="True"/>
                    <BoxContainer Name="PollOptions" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True"/>
                    <Label Name="PollTotal" HorizontalExpand="True"/>
                    <Label Name="PollHint" HorizontalExpand="True"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>
    </ScrollContainer>
</controls:FancyWindow>
