<controls:MortarWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client._RMC14.Mortar"
    xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
    Title="{Loc 'rmc-mortar-interface'}"
    MinSize="380 300">
    <BoxContainer Orientation="Vertical" Margin="4">
        <PanelContainer HorizontalExpand="True" Margin="0 0 0 8">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat
                    BorderColor="#3A3A3A"
                    BorderThickness="1"
                    BackgroundColor="#252525" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="4">
                <RichTextLabel Text="{Loc 'rmc-mortar-target-title'}" HorizontalAlignment="Center" />
                <RichTextLabel Name="MortarPositionLabel" Access="Public" HorizontalAlignment="Center" />
                <BoxContainer Orientation="Horizontal" Margin="4 8">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <BoxContainer Name="TargetXContainer" Access="Public" Orientation="Horizontal" Margin="0 0 0 4">
                            <Label Text="{Loc 'rmc-mortar-target-x'}" Margin="0 0 5 0" />
                        </BoxContainer>
                        <BoxContainer Name="TargetYContainer" Access="Public" Orientation="Horizontal" Margin="0 0 0 8">
                            <Label Text="{Loc 'rmc-mortar-target-y'}" Margin="0 0 5 0" />
                        </BoxContainer>
                        <Button Name="SetTargetButton" Access="Public"
                                Text="{Loc 'rmc-mortar-target-set'}" HorizontalExpand="True" />
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
        <PanelContainer HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat
                    BorderColor="#3A3A3A"
                    BorderThickness="1"
                    BackgroundColor="#252525" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="4">
                <RichTextLabel Text="{Loc 'rmc-mortar-offset-title'}" HorizontalAlignment="Center" />
                <BoxContainer Orientation="Horizontal" Margin="4 8">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <BoxContainer Name="DialXContainer" Access="Public" Orientation="Horizontal" Margin="0 0 0 4">
                            <Label Text="{Loc 'rmc-mortar-offset-x'}" Margin="0 0 5 0" />
                        </BoxContainer>
                        <BoxContainer Name="DialYContainer" Access="Public" Orientation="Horizontal" Margin="0 0 0 8">
                            <Label Text="{Loc 'rmc-mortar-offset-y'}" Margin="0 0 5 0" />
                        </BoxContainer>
                        <Button Name="SetOffsetButton" Access="Public"
                                Text="{Loc 'rmc-mortar-offset-set'}" HorizontalExpand="True" />
                    </BoxContainer>
                </BoxContainer>
                <RichTextLabel Name="MaxDialLabel" Access="Public" HorizontalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:MortarWindow>
