## RoundEndSystem

# Misfits Change - renamed "shuttle" to "train" for wasteland theme.  And in a later update, then renamed to a storm because there is no train present.
round-end-system-shuttle-announcement-sender = Wasteland
# round-end-system-shuttle-called-announcement = An emergency shuttle has been sent. ETA: {$time} {$units}.
round-end-system-shuttle-called-announcement = A major dust storm is about to hit the area. ETA: {$duration}. Find shelter or die in the storm.
round-end-system-shuttle-countdown-announcement = The storm is due to arrive in {$duration}. Find shelter before it arrives, or die.
# round-end-system-shuttle-already-called-announcement = An emergency shuttle has already been sent.
round-end-system-shuttle-already-called-announcement = A storm is already inbound.
# round-end-system-shuttle-auto-called-announcement = An automatic crew shift change shuttle has been sent. ETA: {$time} {$units}. Recall the shuttle to extend the shift.
round-end-system-shuttle-auto-called-announcement = A large storm is approaching the region. ETA: {$duration}. Unless the storm changes course, locate shelter or die outside.
# round-end-system-shuttle-recalled-announcement = The emergency shuttle has been recalled.
round-end-system-shuttle-recalled-announcement = The storm has been temporarily diverted.
round-end-system-round-restart-eta-announcement = Restarting reality in {$duration}...

eta-units-minutes = minutes
eta-units-seconds = seconds
