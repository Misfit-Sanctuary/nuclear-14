gallows-attach-initial-other = {CAPITALIZE(THE($user))} starts fitting the noose around {POSS-ADJ($victim)} neck.
gallows-attach-initial-self = {CAPITALIZE(THE($user))} starts fitting {POSS-ADJ($user)} own neck into the noose.

gallows-attach-complete-other = The noose pulls taut around {POSS-ADJ($victim)} neck!
gallows-attach-complete-self = The noose pulls taut around your neck!

gallows-hang-verb = Hang

gallows-hang-initial-other = {CAPITALIZE(THE($user))} kicks the stool out from under {THE($victim)}!
gallows-hang-initial-self = {CAPITALIZE(THE($user))} kicks the stool out from under {POSS-ADJ($user)} own feet!

gallows-hang-complete-other = {THE($victim)}'s neck snaps taut against the rope.
gallows-hang-complete-self = The rope snaps taut around {POSS-ADJ($victim)} neck.

gallows-struggle-gasp = gasps for air
gallows-struggle-choke = chokes and sputters
gallows-struggle-claw = claws weakly at the rope
gallows-struggle-convulse = convulses in the noose
gallows-struggle-blood = coughs up a mouthful of blood

gallows-too-heavy = {CAPITALIZE(THE($victim))} they're to fat for this rope
