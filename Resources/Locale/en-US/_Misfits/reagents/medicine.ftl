# ============================================================================
# GENERAL MEDICINE AND WASTELAND CHEMS
# ============================================================================

reagent-name-antibiotics = antibiotics
reagent-desc-antibiotics = A broad-spectrum antimicrobial treatment intended for serious or uncertain infections.

reagent-name-radshield = radshield
reagent-desc-radshield = A potent radioprotective compound that shields the body from incoming radiation without removing contamination already absorbed.

reagent-name-x111-compound = x-111 compound
reagent-desc-x111-compound = An advanced radiological treatment that strips large amounts of radiation from the body at alarming speed.

reagent-name-rushing-water = rushing water
reagent-desc-rushing-water = A diluted stimulant mixture that accelerates the body and provides a brief burst of recovery.

reagent-name-blood-shield = blood shield
reagent-desc-blood-shield = A thick wasteland tonic that promotes recovery while helping the body clear circulating toxins.

reagent-name-datura-hide = datura hide
reagent-desc-datura-hide = A sticky datura preparation that deadens sensation and briefly makes injuries easier to endure.

reagent-name-snakebite-tourniquet = snakebite tourniquet
reagent-desc-snakebite-tourniquet = A concentrated field treatment for animal venoms, designed to rapidly purge common wasteland toxins.

reagent-name-fiery-purgative = fiery purgative
reagent-desc-fiery-purgative = A foul, burning mixture that purges poison and radiation at the cost of weakness and nausea.

reagent-name-refreshing-beverage = refreshing beverage
reagent-desc-refreshing-beverage = An extraordinarily rich restorative drink that treats wounds, toxins, radiation and withdrawal all at once.

reagent-name-glowing-blood-pack = glowing blood pack
reagent-desc-glowing-blood-pack = Irradiated blood treated for transfusion, providing minor recovery and temporary protection against further radiation.

reagent-name-herbal-anodyne = herbal anodyne
reagent-desc-herbal-anodyne = A soothing herbal preparation used to dull persistent pain and fight off exhaustion.

reagent-name-herbal-antimicrobial = herbal antimicrobial
reagent-desc-herbal-antimicrobial = A bitter botanical preparation traditionally used against infection, parasites and contaminated wounds.

reagent-name-herbal-stimulant = herbal stimulant
reagent-desc-herbal-stimulant = A sharp herbal tonic that drives away drowsiness and keeps an exhausted patient moving.

reagent-name-skeeto-spit = skeeto spit
reagent-desc-skeeto-spit = A crude blood-based tonic that temporarily bolsters physical endurance.

reagent-name-chlorpromazine = chlorpromazine
reagent-desc-chlorpromazine = A sedating antipsychotic intended to control agitation, delirium and hallucinations.

reagent-name-penicillin = penicillin
reagent-desc-penicillin = A classic antibacterial drug useful against susceptible bacterial infections.

reagent-name-prussian-blue = prussian blue
reagent-desc-prussian-blue = An insoluble binding agent used to slowly draw certain radioactive contaminants and toxins out of the body.

reagent-name-pilgrims-remedy = pilgrim's remedy
reagent-desc-pilgrims-remedy = A mild wasteland cure-all made from common medicinal plants, useful for wounds, toxins and light radiation exposure.

reagent-name-healing-salve = healing salve
reagent-desc-healing-salve = A simple medicinal paste for cuts, burns and other minor injuries.

reagent-name-fury = fury
reagent-desc-fury = A violent combat chem that greatly increases close-quarters aggression, strength and tolerance for injury.

reagent-name-calmex = calmex
reagent-desc-calmex = A refined performance drug that sharpens perception and coordination while producing an unnatural sense of calm.

reagent-name-overdrive = overdrive
reagent-desc-overdrive = A psycho-derived combat stimulant intended to push damage output and combat performance beyond safe limits.

reagent-name-x-cell = x-cell
reagent-desc-x-cell = A rare pre-war prototype chem that enhances nearly every aspect of physical and mental performance.

reagent-name-crank = crank
reagent-desc-crank = A harsh improvised stimulant that increases speed and wakefulness while placing heavy strain on the body.

reagent-name-ghostcap-extract = ghostcap extract
reagent-desc-ghostcap-extract = A neurotoxic fungal extract that distorts perception before progressing into confusion, weakness and collapse.

reagent-name-widows-mercy = widow's mercy
reagent-desc-widows-mercy = A slow systemic poison that weakens the body, impairs breathing and steadily overwhelms its victim.

reagent-name-red-bell-poison = red bell poison
reagent-desc-red-bell-poison = A fast-acting cardiovascular toxin that causes tremors, breathlessness and eventual collapse.

reagent-name-ash-viper-venom = ash viper venom
reagent-desc-ash-viper-venom = An aggressive wasteland venom that rapidly spreads through the bloodstream and leaves its victim weak and unsteady.

reagent-name-lazarus-compound = lazarus compound
reagent-desc-lazarus-compound = An experimental emergency serum capable of dragging a critically injured patient back from the edge, while inflicting severe cellular stress.

reagent-name-clearwake = clearwake
reagent-desc-clearwake = An emergency wakefulness drug that breaks through sedation and collapse long enough to keep a patient conscious.

reagent-name-widowbane = widowbane
reagent-desc-widowbane = A specialized antidote formulated to neutralize widow's mercy and relieve its respiratory effects.

reagent-name-cinder-serum = cinder serum
reagent-desc-cinder-serum = A specialized antidote designed to neutralize red bell poison and stabilize its victim.

reagent-name-gravesalt = gravesalt
reagent-desc-gravesalt = A brutal emergency purgative that clears several dangerous venoms at the cost of violent sickness and bodily strain.

# ============================================================================
# PSYCHIATRIC AND HALLUCINATION TREATMENT
# ============================================================================

reagent-name-misfits-clearhead = clearhead
reagent-desc-misfits-clearhead = A basic psychiatric stabilizer used to clear drug haze and reduce mild perceptual disturbances.

# Compatibility keys for the later psychiatric definition of MisfitsChlorpromazine.
reagent-name-misfits-chlorpromazine = chlorpromazine
reagent-desc-misfits-chlorpromazine = A sedating antipsychotic intended to control agitation, delirium and hallucinations.

reagent-name-misfits-lucidine = lucidine
reagent-desc-misfits-lucidine = A refined neural stabilizer designed to suppress persistent hallucinations with less sedation than older antipsychotics.

reagent-name-misfits-psychocline = psychocline
reagent-desc-misfits-psychocline = A powerful emergency psychiatric drug used to suppress severe delirium and psychotic episodes, often leaving the patient heavily sedated.

reagent-name-misfits-neurostatic = neurostatic
reagent-desc-misfits-neurostatic = An advanced neurological stabilizer intended for severe hallucinations, toxic delirium and other forms of neural instability.

# ============================================================================
# PAIN MANAGEMENT
# ============================================================================

reagent-name-misfits-willowbark = willowbark analgesic
reagent-desc-misfits-willowbark = A bitter pouch of medicinal herbs that dulls persistent pain for a short time.

reagent-name-misfits-anodyne = anodyne
reagent-desc-misfits-anodyne = A basic clinical painkiller that suppresses chronic pain while producing mild drowsiness.

reagent-name-misfits-analgesine = analgesine
reagent-desc-misfits-analgesine = A refined long-lasting analgesic used when ordinary herbal pain relief is no longer sufficient.

reagent-name-misfits-nerveblock = nerveblock
reagent-desc-misfits-nerveblock = A heavy analgesic that strongly suppresses pain by numbing nerve activity, at the cost of sluggish movement and respiratory risk.

reagent-name-misfits-traumadol = traumadol
reagent-desc-misfits-traumadol = A battlefield analgesic that dulls pain while providing limited wound treatment and bleeding control.

reagent-name-misfits-anesthezine = anesthezine
reagent-desc-misfits-anesthezine = A surgical anesthetic that suppresses pain and induces profound sedation, with dangerous consequences at excessive doses.

reagent-name-misfits-neuroblock = neuroblock
reagent-desc-misfits-neuroblock = A high-grade neural analgesic that provides prolonged pain suppression with far less routine sedation than conventional nerve blockers.

reagent-name-misfits-neuroreguline = neuroreguline
reagent-desc-misfits-neuroreguline = An experimental neural regulator intended to suppress severe pain and stabilize disturbed perception at the same time.

# ============================================================================
# NARCOLEPSY AND SLEEP MEDICINE
# ============================================================================

reagent-name-misfits-vigilazine = vigilazine
reagent-desc-misfits-vigilazine = An inexpensive stimulant-derived medicine that postpones narcoleptic attacks without the extreme effects of combat stimulants.

reagent-name-misfits-wakeguard = wakeguard
reagent-desc-misfits-wakeguard = A maintenance drug for narcolepsy that keeps sudden sleep attacks at bay without significantly increasing physical performance.

reagent-name-misfits-somnoreguline = somnoreguline
reagent-desc-misfits-somnoreguline = An advanced sleep-regulation medicine that delays narcoleptic episodes for an extended period and can break through forced sleep.
