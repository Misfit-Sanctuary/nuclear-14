uniform sampler2D MASK_TEXTURE;

uniform highp vec2 eyePos;
uniform highp vec2 eyePixel;
uniform highp float pixelsPerTile;

uniform highp float intensity;
uniform highp float fall;
uniform highp float drift;

uniform highp float density;
uniform highp float flakeSize;
uniform highp float sway;
uniform highp float haze;
uniform highp float landing;

uniform highp float clearRadius;
uniform highp float clearBuffer;

const highp float ART = 32.0;

highp float hash12(highp vec2 p) {
    highp vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

highp vec2 hash22(highp vec2 p) {
    highp vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.xx + p3.yz) * p3.zy);
}

highp float valueNoise(highp vec2 p) {
    highp vec2 i = floor(p);
    highp vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    highp float a = hash12(i);
    highp float b = hash12(i + vec2(1.0, 0.0));
    highp float c = hash12(i + vec2(0.0, 1.0));
    highp float d = hash12(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

highp float flakeLayer(highp vec2 world, highp float depth, highp float cellTiles, highp float speed,
                       highp float sizeArt, highp float chance, highp float seed) {
    highp vec2 p = eyePos + (world - eyePos) * depth;
    p += vec2(-drift * speed, fall * speed);
    p = floor(p * ART) / ART;

    highp vec2 cellPos = p / cellTiles + seed;
    highp vec2 cell = floor(cellPos);

    if (hash12(cell * 1.7 + seed) > chance) {
        return 0.0;
    }

    highp vec2 r = hash22(cell + seed * 3.1);
    highp float size = sizeArt * (0.65 + 0.7 * r.y);

    highp float edge = clamp(size / (cellTiles * ART), 0.0, 0.4);
    highp vec2 centre = mix(vec2(edge + 0.05), vec2(0.95 - edge), r);
    highp float wobble = sin(TIME * (0.9 + r.y * 1.6) + r.x * 6.283);
    centre.x += sway * 0.1 * wobble;
    centre.x = clamp(centre.x, edge, 1.0 - edge);

    highp vec2 d = (fract(cellPos) - centre) * cellTiles * ART;
    highp float shape = max(abs(d.x), abs(d.y)) * 0.55 + length(d) * 0.45;
    return 1.0 - smoothstep(size * 0.5 - 0.25, size * 0.5 + 0.5, shape);
}

highp float landingSpecks(highp vec2 world) {
    highp vec2 p = floor(world * ART) / ART;
    highp float cellTiles = 0.5;
    highp vec2 cellPos = p / cellTiles;
    highp vec2 cell = floor(cellPos);

    highp float rate = 0.3 + 0.4 * landing;
    highp float phase = TIME * rate + hash12(cell * 1.31);
    highp float cycle = floor(phase);
    highp float age = fract(phase);

    if (hash12(cell + cycle * 3.7) > clamp(landing * 0.5, 0.0, 0.9)) {
        return 0.0;
    }

    highp vec2 r = hash22(cell + cycle * 17.0);
    highp vec2 d = (fract(cellPos) - (0.15 + 0.7 * r)) * cellTiles * ART;
    highp float speck = 1.0 - step(0.75, max(abs(d.x), abs(d.y)));
    highp float life = smoothstep(0.0, 0.06, age) * (1.0 - smoothstep(0.15, 1.0, age));
    return speck * life * 0.8;
}

void fragment() {
    highp vec2 world = eyePos + (FRAGCOORD.xy - eyePixel) / pixelsPerTile;

    highp float far = flakeLayer(world, 0.8, 0.4, 0.55, 1.0, density * 0.9, 11.0);
    highp float mid = flakeLayer(world, 1.0, 0.65, 1.0, 1.0 + flakeSize * 0.6, density * 0.65, 37.0);
    highp float near = flakeLayer(world, 1.3, 1.1, 1.6, 1.5 + flakeSize * 1.3, density * 0.4, 71.0);
    highp float ground = landingSpecks(world);

    highp float flakes = max(max(far * 0.5, mid * 0.8), max(near * 0.9, ground));

    highp float sheets = valueNoise(world * 0.3 + vec2(-drift * 1.4, fall * 0.25));
    sheets = sheets * 0.6 + valueNoise(world * 0.9 + vec2(-drift * 2.2, fall * 0.5)) * 0.4;
    highp float spread;
    if (clearRadius > 0.0) {
        highp float dist = length(world - eyePos);
        spread = smoothstep(clearRadius, clearRadius + max(clearBuffer, 0.5) * 3.0, dist);
    } else {
        highp vec2 sc = FRAGCOORD.xy * SCREEN_PIXEL_SIZE - 0.5;
        spread = clamp(length(sc) * 1.4, 0.0, 1.0);
    }
    highp float hazeA = haze * (0.3 + 0.7 * spread) * (0.55 + 0.9 * sheets);
    hazeA = clamp(hazeA, 0.0, 0.85);

    highp vec3 flakeCol = vec3(0.95, 0.97, 1.0);
    highp vec3 hazeCol = vec3(0.84, 0.87, 0.92);

    highp float outA = flakes + hazeA * (1.0 - flakes);
    highp vec3 rgb = (flakeCol * flakes + hazeCol * hazeA * (1.0 - flakes)) / max(outA, 0.001);

    highp vec2 maskUv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    highp float maskAlpha = texture2D(MASK_TEXTURE, maskUv).a;
    outA *= (1.0 - maskAlpha) * intensity;

    if (outA <= 0.002) {
        discard;
    }

    COLOR = vec4(rgb, outA);
}
